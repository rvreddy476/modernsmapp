# Local development defaults only.
# Copy to `.env` if you want Docker Compose to auto-load these values.

POSTGRES_USER=postgres
JWT_SECRET=local_dev_jwt_change_me
INTERNAL_SERVICE_KEY=local_dev_internal_service_key_change_me

POSTGRES_PASSWORD=postgres
IDENTITY_POSTGRES_USER=postgres
IDENTITY_POSTGRES_PASSWORD=postgres
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false
REDIS_TLS_INSECURE_SKIP_VERIFY=false
REDIS_TLS_SERVER_NAME=
REDIS_CA_CERT_FILE=
REDIS_CLIENT_CERT_FILE=
REDIS_CLIENT_KEY_FILE=

MINIO_ROOT_USER=minio
# Keep these aligned with the root credentials unless you provision a separate MinIO app user.
MINIO_ROOT_PASSWORD=local_dev_minio_password_change_me
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=local_dev_minio_password_change_me
OPENSEARCH_INITIAL_ADMIN_PASSWORD=local_dev_opensearch_admin_password_change_me
GF_SECURITY_ADMIN_PASSWORD=local_dev_grafana_admin_password_change_me
KAFKA_TLS_ENABLED=false
KAFKA_TLS_INSECURE_SKIP_VERIFY=false
KAFKA_TLS_SERVER_NAME=
KAFKA_CA_CERT_FILE=
KAFKA_CLIENT_CERT_FILE=
KAFKA_CLIENT_KEY_FILE=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_DIAL_TIMEOUT=10s

CORS_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DOMAIN=localhost
WS_ALLOW_QUERY_TOKEN=true
LIVEKIT_HOST=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ICE_SERVERS_JSON=

# ── Transactional email (notification-service) ──
# Blank SMTP_HOST → NoopMailer (no email). Fill these to send real order/
# shipping emails. Examples: Mailgun smtp.mailgun.org:587 · SendGrid
# smtp.sendgrid.net:587 (username = "apikey") · Gmail smtp.gmail.com:587 (app pw).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=atPost
SMTP_FROM_ADDR=no-reply@yourdomain.com

# ── Doorstep (doorstep-service) ──
# Dev-only values; never reuse one in QA or production. Generate with:
#   DOORSTEP_PII_KEYS        "v1:" + `openssl rand -base64 32`
#   DOORSTEP_PII_LOOKUP_SALT `openssl rand -hex 32`
#   DOORSTEP_SERVICE_TOKEN_KEY / _KID  an Ed25519 seed (base64, 32 bytes) and
#     its kid; the public half + the same kid go to payments-service as
#     SERVICE_CALLER_DOORSTEP_SERVICE_PUBKEY / _KID, and doorstep-service is
#     added to SERVICE_CALLERS (payments').
#   DOORSTEP_SERVICE_CALLERS "admin-service" once ADMIN_SERVICE_TOKEN_PUBKEY is set.
# Unset, the PII routes answer 503 and payments are unavailable.
DOORSTEP_PII_KEYS=
DOORSTEP_PII_LOOKUP_SALT=
DOORSTEP_SERVICE_TOKEN_KEY=
DOORSTEP_SERVICE_TOKEN_KID=
DOORSTEP_SERVICE_CALLERS=
# The gateway's Doorstep gate (closed; the pilot defaults to call_a, call_b).
DOORSTEP_PUBLIC_ENABLED=false

# ── Chat field encryption at rest (chat-message-service, 22 Oct 2026) ──
# Message text and every other content-bearing chat field is sealed in Scylla
# and Postgres (no end-to-end encryption for launch). Set exactly ONE of:
#   CHAT_FIELD_KEYS  development keyring, versioned base64 32-byte keys:
#                    "v1:" + `openssl rand -base64 32` (rotate by appending
#                    ",v2:<key>"; the newest seals, all versions open). Never
#                    reuse a dev key anywhere else; refused in production.
#   CHAT_KMS_KEY_ID  the KMS key that wraps the content keys (staging, QA,
#                    production; the deploy values read it from the
#                    chat-message-service secret as chat_kms_key_id).
# Both unset outside production: plaintext, with one warning at boot. With
# APP_ENV=production message-service refuses to boot without CHAT_KMS_KEY_ID.
# Losing a key loses every message sealed under it.
CHAT_FIELD_KEYS=
# Published outbox rows (copies of message text) are deleted after this long.
OUTBOX_RETENTION=168h
