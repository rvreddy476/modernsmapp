# Markdown files (scratch notes stay out of git)...
*.md
# ...but the docs/ tree is real documentation — keep it tracked.
!docs/**

# Binaries
*.exe
*.bin
server

# Loose APK build artifacts at the repo root (rebuildable via Gradle)
/*.apk

# IDE
.idea/

# Local settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
.claude/worktrees/
technicaldesign/

# Temp files
.tmp/

# Build caches
.gocache/
__pycache__/

# Environment files
Architecture/docker/.env

# Prompt/spec files
prompt/

# Local secrets (generated by hand, never commit)
.secrets/

# Codex/agent Go build cache — tool artifact, never source.
.codex-cache/

# Swift Package Manager build output. The Android side already ignores
# Gradle's `build/`; SPM's is dot-prefixed and slipped past that rule,
# which put 694 generated files into a commit.
.build/
**/.build/
