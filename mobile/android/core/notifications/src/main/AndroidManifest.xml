<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Runtime permission from Android 13. Before it, notifications were granted
      on install; now a user who declines gets none, and posting without it
      throws rather than being ignored.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Declared HERE rather than in :app, because this module owns the class.
          Beyond ownership it is what lets lint resolve the superclass: a
          <service> in app's manifest naming a class from a library module
          fails Instantiatable, since lint checks the manifest against the
          module's own sources.
        -->
        <service
            android:name="com.us.android.core.notifications.UsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
