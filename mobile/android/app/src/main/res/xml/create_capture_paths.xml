<?xml version="1.0" encoding="utf-8"?>
<!--
  Where the Create hub's camera captures land. cache-path: a capture that never
  becomes a post should be reclaimable by the OS, and one that does become a
  post is copied into the SourceVault immediately.
-->
<paths>
    <cache-path name="create_capture" path="create_capture/" />
    <!-- Photos exported by the advanced photo editor, copied here before the
         profile uploader reads them back through this provider. -->
    <cache-path name="photo_edits" path="photo_edits/" />
</paths>
