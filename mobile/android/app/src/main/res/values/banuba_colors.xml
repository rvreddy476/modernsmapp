<?xml version="1.0" encoding="utf-8"?>
<!--
  VChat colours for the Banuba Video Editor (2026-09-05; black since 23 Oct 2026).

  The SDK paints from named colour resources (read out of the 1.54.1 AARs:
  core-ui-sdk, camera-ui-sdk, ve-ui-sdk, ve-gallery-sdk); an app resource of
  the same name replaces the library's at merge, which is the vendor's own
  theming route. Values (black, founder 23 Oct: no navy anywhere): ground
  #000000, surface #121212, raised #1C1C1E, hover/border #2C2C2E, white text,
  ember accent #DC2626. Only the SDK's neutral chrome and its record/select
  accents are mapped; per-effect timeline colours are left alone.
-->
<resources>
    <!-- Ground: the editor, trimmer and gallery canvases. -->
    <color name="backgroundDark">#FF000000</color>
    <color name="backgroundGlobalPrimary">#FF000000</color>
    <color name="bg_editor_v2">#FF000000</color>
    <color name="bg_primary_dark">#FF000000</color>
    <color name="primaryBrandDark">#FF000000</color>

    <!-- Surfaces: sheets, panels, pickers, the music/volume dialogs. -->
    <color name="surfaceDark">#FF121212</color>
    <color name="bg_container_color_dark">#FF121212</color>
    <color name="shark">#FF121212</color>
    <color name="volume_dialog_background">#FF121212</color>
    <color name="stickers_background_color">#FF121212</color>
    <color name="carbon">#FF121212</color>
    <color name="tuna">#FF121212</color>
    <color name="mineShaft">#FF121212</color>
    <color name="auto_cut_track_not_selected">#FF121212</color>

    <!-- Raised surfaces: alerts, the text tool's colour strip, list items. -->
    <color name="neutralDark">#FF1C1C1E</color>
    <color name="quartz">#FF1C1C1E</color>
    <color name="blackOlive">#FF1C1C1E</color>
    <color name="shaft">#FF1C1C1E</color>
    <color name="bg_container_high_color_dark">#FF2C2C2E</color>

    <!-- Text stays white; "primary brand light" is the SDK's text-on-dark. -->
    <color name="neutralLight">#FFFFFFFF</color>
    <color name="primaryBrandLight">#FFFFFFFF</color>

    <!-- Ember accent: the record button, progress, active states, selection. -->
    <color name="progress_red">#FFDC2626</color>
    <color name="venetianRed">#FFDC2626</color>
    <color name="warning">#FFDC2626</color>
    <color name="activeRed">#FFDC2626</color>
    <color name="torch_red">#FFDC2626</color>
    <color name="torch_red40">#66DC2626</color>
    <color name="dodgerBlue">#FFDC2626</color>
    <color name="blue">#FFDC2626</color>
    <color name="primaryDecorView">#FFDC2626</color>

    <!--
      Photo Editor (pe-sdk 1.4.2). Its PhotoCreationTheme is MediaCreationTheme.Dark,
      whose ground and containers are the *_dark names above. What is left:
      the primary action (a white "secondary container" with near-black text)
      becomes ember with white text, borders take the dark border, and the
      module's own `red` (reset / delete) is the ember. Translucent whites for
      inactive and disabled states are left alone.
    -->
    <color name="bg_container_secondary_color_dark">#FFDC2626</color>
    <color name="text_secondary_dark">#FFFFFFFF</color>
    <color name="border_dark">#FF2C2C2E</color>
    <color name="red">#FFDC2626</color>
</resources>
