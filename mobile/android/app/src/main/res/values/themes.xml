<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Splash theme. Painted by the system before any Compose frame exists,
      so it must match the app background exactly or the launch flashes.
    -->
    <style name="Theme.Us.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/us_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Us</item>
    </style>

    <style name="Theme.Us" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/us_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Banuba Video Editor (2026-09-05). The SDK's VideoCreationTheme is a map
      of ~300 widget styles over a handful of colour resources; those
      resources are overridden by name in banuba_colors.xml (navy ground and
      surfaces, white text, the ember accent), and its Roboto font resources
      are overridden in res/font. What is left for the theme itself is the
      window: navy behind every screen so no frame flashes grey between the
      SDK's fragments, and transparent bars like Theme.Us.
    -->
    <style name="Theme.Momentum.VideoCreation" parent="VideoCreationTheme">
        <item name="android:windowBackground">@color/us_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      Banuba Photo Editor (2026-09-05). Its PhotoCreationTheme is the SDK's
      MediaCreationTheme.Dark plus a window background; the colour resources
      that theme names are overridden in banuba_colors.xml alongside the video
      editor's, so both editors are navy, white and ember. Same window
      treatment as the video activity.
    -->
    <style name="Theme.Momentum.PhotoCreation" parent="PhotoCreationTheme">
        <item name="android:windowBackground">@color/us_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
