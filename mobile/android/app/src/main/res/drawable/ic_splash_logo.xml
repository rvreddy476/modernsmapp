<?xml version="1.0" encoding="utf-8"?>
<!--
  VChat's splash mark. The system splash clips the icon to a circle, so the
  sunset gradient is drawn as a disc and the white bubble sits on it; on the
  magenta splash ground (values/colors.xml → vchat_splash) the disc reads as
  a glowing badge. Same bubble and play cut-out as the launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M54,54 m-40,0 a40,40 0 1,1 80,0 a40,40 0 1,1 -80,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14" android:startY="14"
                android:endX="94" android:endY="94">
                <item android:offset="0" android:color="#FF7B2FF7" />
                <item android:offset="0.4" android:color="#FFF107A3" />
                <item android:offset="0.75" android:color="#FFFF7A18" />
                <item android:offset="1" android:color="#FFFFD200" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M40,33 H68 A10,10 0 0 1 78,43 V61 A10,10 0 0 1 68,71 H50 L39,79 V71 H40 A10,10 0 0 1 30,61 V43 A10,10 0 0 1 40,33 Z M49,43 V61 L64,52 Z" />
</vector>
