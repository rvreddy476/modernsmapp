<?xml version="1.0" encoding="utf-8"?>
<!--
  Momentum / Unified Services (US) Sunset Launcher Background
  No gold/yellow. Sunset palette: Electric Blue -> Deep Purple -> Neon Pink -> Coral Red.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sunset Gradient Backdrop -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF1E1B4B" android:offset="0.0" />
                <item android:color="#FF3B82F6" android:offset="0.25" />
                <item android:color="#FF7C3AED" android:offset="0.5" />
                <item android:color="#FFEC4899" android:offset="0.78" />
                <item android:color="#FFF43F5E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-Right Cyan Glow Accent -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:alpha="0.30">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="85"
                android:centerY="22"
                android:gradientRadius="65"
                android:type="radial">
                <item android:color="#FF38BDF8" android:offset="0.0" />
                <item android:color="#0038BDF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Edge Vignette -->
    <path
        android:pathData="M0,0h108v108h-108z"
        android:alpha="0.22">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="72"
                android:type="radial">
                <item android:color="#00000000" android:offset="0.5" />
                <item android:color="#FF000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
