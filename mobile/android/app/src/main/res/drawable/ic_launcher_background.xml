<?xml version="1.0" encoding="utf-8"?>
<!--
  Momentum / Unified Services (US) Colorful Launcher Icon Background
  Dark violet to deep indigo gradient with vibrant ambient magenta and cyan glows.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Rich dark violet to deep indigo backdrop -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF0F172A" android:offset="0.0" />
                <item android:color="#FF1E1B4B" android:offset="0.5" />
                <item android:color="#FF2A0845" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-Right Vibrant Magenta/Pink Ambient Glow -->
    <path
        android:pathData="M30,0 L108,0 L108,78 Z"
        android:alpha="0.45">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="108"
                android:startY="0"
                android:endX="40"
                android:endY="60"
                android:type="linear">
                <item android:color="#FFEC4899" android:offset="0.0" />
                <item android:color="#00EC4899" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bottom-Left Vibrant Cyan/Electric Blue Ambient Glow -->
    <path
        android:pathData="M0,30 L0,108 L78,108 Z"
        android:alpha="0.35">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="108"
                android:endX="60"
                android:endY="40"
                android:type="linear">
                <item android:color="#FF06B6D4" android:offset="0.0" />
                <item android:color="#0006B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
