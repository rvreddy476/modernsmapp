<?xml version="1.0" encoding="utf-8"?>
<!--
  VChat's launcher mark: a white chat bubble with a play triangle cut out of
  it (chat + video in one glyph). The gradient is the adaptive icon's
  background layer (drawable/ic_launcher_background.xml), so this foreground
  is the glyph alone and reads as a monochrome themed icon too. The
  triangle is an even-odd hole, so the gradient shows through it. Geometry
  stays inside the 66dp safe zone of the 108dp canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M40,33 H68 A10,10 0 0 1 78,43 V61 A10,10 0 0 1 68,71 H50 L39,79 V71 H40 A10,10 0 0 1 30,61 V43 A10,10 0 0 1 40,33 Z M49,43 V61 L64,52 Z" />
</vector>
