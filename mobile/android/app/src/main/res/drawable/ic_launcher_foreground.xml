    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M40,33 H68 A10,10 0 0 1 78,43 V61 A10,10 0 0 1 68,71 H50 L39,79 V71 H40 A10,10 0 0 1 30,61 V43 A10,10 0 0 1 40,33 Z M49,43 V61 L64,52 Z" />
</vector>
