<?xml version="1.0" encoding="utf-8"?>
<!--
  DEV FLAVOR ONLY. Overrides the strict policy in src/main/res/xml/.

  Cleartext is permitted to ANY host in a dev build. The dev stack is reached
  over plain http — the emulator's host alias `10.0.2.2`, or the workstation's
  LAN address from a physical handset — and that address changes with the
  network, so it cannot be a fixed entry here.

  ## WHY NOT A LIST OF PRIVATE RANGES

  An earlier version of this file listed `192.168.0.0`, `10.0.0.0` and
  `172.16.0.0` with includeSubdomains="true", believing that covered every
  RFC 1918 address. It did not: <domain> entries are HOSTNAMES matched by DNS
  suffix, not CIDR ranges, so a workstation at 192.168.1.2 was still refused
  with "CLEARTEXT communication not permitted" and the app reported itself
  offline (2026-09-04). A -PdevHost build could never have worked.

  The tunnel build (-PdevApiUrl=https://…) is TLS end to end and never uses
  this exemption. Staging and production builds do not include this file and
  keep the strict base-config.

  Build a device APK with:
    ./gradlew.bat assembleDevDebug -PdevHost=192.168.1.2
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
