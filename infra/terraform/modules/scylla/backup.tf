# ScyllaDB backups (feed-12): Scylla Manager + a daily backup task to S3.
#
# Until this file the cluster had no backup of any kind. With
# var.backup_enabled = true the module adds:
#
#   1. Scylla Manager (the operator's `scylla-manager` chart, namespace
#      scylla-manager, with the small Scylla it keeps its own state in). The
#      operator registers every ScyllaCluster with it and turns the CR's
#      `spec.backups` into Manager tasks.
#   2. `spec.backups` on the ScyllaCluster: one task, every day at
#      var.backup_cron (UTC), all keyspaces, to s3:<var.backup_bucket_name>,
#      keeping the last var.backup_retention backups.
#   3. The agent's S3 settings (Secret `scylla-agent-config`, which the racks
#      already name) and the IAM role on the pods' ServiceAccount
#      (<cluster>-member), so the Scylla Manager agent sidecar can write to
#      the bucket without a static key.
#
# The bucket, its lifecycle and the role are per environment:
# envs/<env>/scylla-backup.tf.
#
# UNPROVEN. Written from the operator's documented interface, never planned
# or applied (no Terraform, cluster or AWS access from the authoring
# session). Points to check on the first QA apply:
#   - `cron` / `timezone` on a backup task need scylla-operator >= 1.12 (the
#     module pins 1.14.0). If `terraform plan` rejects them, use
#     `interval = "1d"` instead.
#   - the ServiceAccount annotation is applied to an object the operator
#     creates a little after the ScyllaCluster: if the first apply fails with
#     "not found" on kubernetes_annotations.scylla_member_irsa, apply again.
#     If the operator ever strips the annotation, the fallback is to attach
#     the bucket policy to the Scylla node group's instance role.
#   - pods started before the annotation existed have no AWS identity; the
#     runbook's first-time steps restart them one by one.
#   - the scylla-manager chart values are left at the chart's defaults.
# docs/runbooks/restore-scylla.md has the first-time checks and the restore
# drill.

locals {
  scylla_cluster_name = "atpost-${var.environment}"

  # Merged into the ScyllaCluster spec (main.tf). Empty when backups are off,
  # so the CR is exactly what it was before this file existed.
  backup_spec = {
    for k, v in {
      backups = [{
        name       = "daily"
        location   = ["s3:${var.backup_bucket_name}"]
        cron       = var.backup_cron
        timezone   = "UTC"
        retention  = var.backup_retention
        numRetries = 3
      }]
    } : k => v if var.backup_enabled
  }
}

resource "kubernetes_namespace" "scylla_manager" {
  count = var.backup_enabled ? 1 : 0

  metadata {
    # The operator looks for Scylla Manager in this namespace by name.
    name = "scylla-manager"
    labels = {
      "app.kubernetes.io/managed-by" = "terraform"
    }
  }
}

resource "helm_release" "scylla_manager" {
  count = var.backup_enabled ? 1 : 0

  name       = "scylla-manager"
  repository = "https://scylla-operator-charts.storage.googleapis.com/stable"
  chart      = "scylla-manager"
  version    = var.operator_chart_version
  namespace  = kubernetes_namespace.scylla_manager[0].metadata[0].name

  depends_on = [helm_release.scylla_operator, kubernetes_storage_class.gp3]
}

# scylla-manager-agent.yaml for the agent sidecar in every Scylla pod. No
# credentials: the agent uses the pod's IAM role (below). The auth token the
# agent and Manager share is generated by the operator.
resource "kubernetes_secret" "scylla_agent_config" {
  count = var.backup_enabled ? 1 : 0

  metadata {
    name      = "scylla-agent-config"
    namespace = kubernetes_namespace.scylla.metadata[0].name
  }

  data = {
    "scylla-manager-agent.yaml" = yamlencode({
      s3 = {
        region = var.aws_region
      }
    })
  }
}

# IRSA: the operator creates ServiceAccount <cluster>-member for the Scylla
# pods and offers no field for its annotations, so the role is attached here.
resource "kubernetes_annotations" "scylla_member_irsa" {
  count = var.backup_enabled ? 1 : 0

  api_version = "v1"
  kind        = "ServiceAccount"

  metadata {
    name      = "${local.scylla_cluster_name}-member"
    namespace = kubernetes_namespace.scylla.metadata[0].name
  }

  annotations = {
    "eks.amazonaws.com/role-arn" = var.backup_irsa_role_arn
  }

  depends_on = [kubernetes_manifest.scylla_cluster]
}
