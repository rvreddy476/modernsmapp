# Copy to `prod.tfvars` (gitignored) and fill in every CHANGEME. Pass with
# `terraform plan -var-file=prod.tfvars`. Every other variable has the LEAN
# default from variables.tf; the commented lines show the knob and its
# default so growing later is a one-line change here.

# ─── REQUIRED ────────────────────────────────────────────────────────────

# From `terraform output` in bootstrap/ (state bucket + lock table).
tfstate_bucket_arn     = "arn:aws:s3:::atpost-tfstate-CHANGEME"
tfstate_lock_table_arn = "arn:aws:dynamodb:ap-south-1:CHANGEME:table/atpost-tfstate-locks"

# Receives budget, backup, GuardDuty and SES bounce alerts. SNS emails a
# confirmation link on the first apply — click it or nothing arrives.
ops_alert_email = "CHANGEME@example.com"

# CIDRs allowed to reach the prod EKS public API endpoint. Narrow to the
# office / VPN / on-call addresses. Never 0.0.0.0/0 in prod.
cluster_endpoint_public_access_cidrs = [
  "203.0.113.0/24", # CHANGEME — office
  # "198.51.100.5/32", # CHANGEME — on-call laptop
]

# IAM principals that get cluster-admin on EKS access entries (break-glass +
# on-call). The CI role does NOT need admin.
cluster_admin_arns = [
  "arn:aws:iam::CHANGEME:role/AdminBreakGlass",
]

# GitHub OIDC trust. Replace ORG with the GitHub organisation / user that
# owns the repositories.
github_repos = ["ORG/atpost"] # only used if ci_github_subjects is empty
ci_github_subjects = [
  "repo:ORG/atpost:ref:refs/heads/main",
  "repo:ORG/atpost:ref:refs/heads/release/prod",
  "repo:ORG/atpost:pull_request", # terraform plan on PRs (read-only + state)
]
# The Terraform APPLY role: only a job in the GitHub environment `prod`.
# Create that environment with "Deployment branches: main" and a required
# reviewer — GitHub enforces the branch before minting the token.
terraform_apply_github_subjects = ["repo:ORG/atpost:environment:prod"]
# create_terraform_apply_role = true

# ─── Hosts and email ─────────────────────────────────────────────────────
# domain                      = "cleestudio.com"
# public_subdomains           = ["api", "ws", "app", "admin"]
# media_subdomain             = "media"
# ses_from_address            = "no-reply@cleestudio.com"
# ses_configuration_set_name  = "atpost-prod-transactional"
# dmarc_report_address        = null  # → ops_alert_email

# Flip to true ONLY after `aws acm describe-certificate --region us-east-1`
# shows ISSUED for media.cleestudio.com (its validation CNAME is in the
# cloudflare_dns_records output). Then apply again: the distribution gains
# the alias and the certificate.
media_custom_domain_enabled = false

# ─── Lean profile (defaults shown; uncomment to grow) ────────────────────
# single_nat_gateway           = true          # false → one NAT per AZ

# eks_cluster_version          = "1.36"
# general_node_instance_type   = "m7g.xlarge"
# general_node_min             = 3
# general_node_max             = 8
# general_node_desired         = 3
# system_node_instance_type    = "m7g.medium"
# system_node_min              = 2
# system_node_max              = 3
# system_node_desired          = 2
# memory_node_instance_type    = "m7g.large"   # r7g.xlarge in the full design
# memory_node_min              = 3
# memory_node_max              = 3
# memory_node_desired          = 3
# karpenter_chart_version      = "1.14.1"
# karpenter_capacity_types     = ["on-demand"] # ["spot","on-demand"] once SLOs allow

# scylla_cpu_per_replica       = "1500m"
